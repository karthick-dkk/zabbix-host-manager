{
	"manifest_version": 2.0,
	"id": "hostflow",
	"name": "Host Flow",
	"namespace": "HostFlow",
	"version": "1.4.1",
	"author": "karthick-dkk",
	"description": "Editable draw.io diagrams inside Zabbix with live host IPs, problems and AWS cost.",
	"actions": {
		"hostflow.list": { "class": "DiagramView", "view": "hostflow.view" },
		"hostflow.view": { "class": "DiagramView", "view": "hostflow.view" },
		"hostflow.embed": { "class": "DiagramView", "view": "hostflow.view", "layout": "layout.hostflow.embed" },
		"hostflow.edit": { "class": "DiagramEdit", "view": "hostflow.edit" },
		"hostflow.wall": { "class": "DiagramWall", "view": "hostflow.wall", "layout": "layout.htmlpage" },
		"hostflow.locate": { "class": "DiagramLocate" },
		"hostflow.settings": { "class": "SettingsView", "view": "hostflow.settings" },
		"hostflow.cost": { "class": "CostView", "view": "hostflow.cost" },
		"hostflow.cost.export": { "class": "CostExport", "layout": "layout.csv" },

		"hostflow.data": { "class": "DiagramData", "layout": "layout.json" },
		"hostflow.summary": { "class": "DiagramSummary", "layout": "layout.json" },
		"hostflow.load": { "class": "DiagramLoad", "layout": "layout.json" },
		"hostflow.save": { "class": "DiagramSave", "layout": "layout.json" },
		"hostflow.delete": { "class": "DiagramDelete", "layout": "layout.json" },
		"hostflow.seen": { "class": "DiagramSeen", "layout": "layout.json" },
		"hostflow.generate": { "class": "DiagramGenerate", "layout": "layout.json" },
		"hostflow.autoflows": { "class": "AutoFlowsRun", "layout": "layout.json" },
		"hostflow.capacity": { "class": "CapacityData", "layout": "layout.json" },
		"hostflow.mapimport": { "class": "MapImport", "layout": "layout.json" },
		"hostflow.hosts": { "class": "HostSearch", "layout": "layout.json" },
		"hostflow.items": { "class": "ItemSearch", "layout": "layout.json" },
		"hostflow.find": { "class": "DiagramFind", "layout": "layout.json" },
		"hostflow.clients": { "class": "ClientList", "layout": "layout.json" },
		"hostflow.settings.update": { "class": "SettingsUpdate", "layout": "layout.json" },
		"hostflow.script.install": { "class": "ScriptInstall", "layout": "layout.json" },
		"hostflow.deps": { "class": "DependencySuggest", "layout": "layout.json" },
		"hostflow.deps.apply": { "class": "DependencyApply", "layout": "layout.json" },
		"hostflow.services": { "class": "ServiceBuild", "layout": "layout.json" },
		"hostflow.cost.data": { "class": "CostData", "layout": "layout.json" },
		"hostflow.cost.refresh": { "class": "CostRefresh", "layout": "layout.json" },
		"hostflow.aws.test": { "class": "AwsTest", "layout": "layout.json" }
	},
	"config": {}
}
